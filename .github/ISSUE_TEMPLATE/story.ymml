name: Story
description: This is a requirement ticket
title: "[story] "
labels: [story,platform,normal,tbd]
assignee: lmsupport@logicmatter.com
body:
  - type: dropdown
    attributes:
      label: Platform Version
      description: What version of platform
      options:
        - PMFWv3.0.x
        - PMFWv3.1.x
        - PMFWv3.2.x
        - PMFWv3.3.x
        - PMFWv3.4.x        
      validations:
        required: false
- type: markdown
  attributes:
    value: "## Thank you for contributing to our project!"
- type: markdown
  attributes:
    value: |
      Thanks for taking the time to fill out this bug report.        
  - type: dropdown
    attributes: 
      label: Solution Version
      description: What version of the solution
      options:
        - BMS-Patch-General
        - BMS-Custom-Patch
        - OEM-Patch-General
        - OEM-Custom-Patch
        - WMS-Patch-General
        - WMS-Custom-Patch        
        - Other-Solution
      validations:
        required: true
